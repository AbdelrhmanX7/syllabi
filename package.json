{
  "name": "syllabi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @repo/study dev",
    "build": "pnpm --filter @repo/study build",
    "lint": "pnpm --filter @repo/study lint",
    "test": "pnpm --filter @repo/study test",
    "release:android": "pnpm --filter @repo/study release:android",
    "server:dev": "pnpm --filter @syllabi/server dev",
    "server:build": "pnpm --filter @syllabi/server build",
    "server:start": "pnpm --filter @syllabi/server start",
    "server:typecheck": "pnpm --filter @syllabi/server typecheck"
  },
  "devDependencies": {
    "playwright": "1.61.0"
  }
}
