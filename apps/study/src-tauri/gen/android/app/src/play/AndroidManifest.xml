<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build only (STUDY_STORE=play, scripts/build-play.mjs): merged over src/main's manifest as
     the release build type's manifest (see build.gradle.kts), so these removals win.
     - No self-update outside Play: drop the installer permission and the provider that hands a
       downloaded APK to the system installer (AppUpdater.kt is not attached in this build).
     - USE_EXACT_ALARM is for alarm and calendar apps only. Reminders fall back to inexact alarms
       (setAndAllowWhileIdle) when exact ones are not allowed; SCHEDULE_EXACT_ALARM (maxSdk 32) stays. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />

    <application>
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            tools:node="remove" />
    </application>
</manifest>
