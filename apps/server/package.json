{
  "name": "@syllabi/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hostable backend for Syllabi: serves the /study API the app calls.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "dev:worker": "ts-node-dev --transpile-only -r tsconfig-paths/register src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "owner": "ts-node --transpile-only -r tsconfig-paths/register src/auth/cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.632.0",
    "@logtail/node": "^0.5.6",
    "@logtail/types": "^0.5.6",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "8.21.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^6.42.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.16.0",
    "sanitize-html": "2.17.5",
    "sharp": "^0.33.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.16.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
