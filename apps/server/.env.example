# Syllabi server configuration. Copy to .env (cd apps/server && cp .env.example .env) and fill in.
# Every variable the server reads is listed here. Optional ones are commented out: uncomment to
# set them. Leave a value out rather than writing NAME= (an empty value is not always "unset").
# No real secrets belong in this file.

# ─── HTTP ────────────────────────────────────────────────────────────────────────────────
# Port to listen on (default 5000).
PORT=5000
# Interface to bind (default 127.0.0.1 = this machine only). Use 0.0.0.0 only inside a container,
# and then publish the port on 127.0.0.1 (docker-compose.yml does this).
HOST=127.0.0.1
# This server's public origin as the app/tablet reaches it, e.g. https://syllabi.example.com or
# http://192.168.1.20:5000. Used to build local/proxied file urls. Default http://localhost:$PORT.
PUBLIC_BASE_URL=
# Express "trust proxy" setting: hop count (1) or a list of proxy addresses. Default 1.
# TRUST_PROXY=
# "production" changes the storage default to s3 (see STORAGE_DRIVER).
# NODE_ENV=

# ─── docker compose only ─────────────────────────────────────────────────────────────────
# Read by docker-compose.yml (not by the server). MINIO_ROOT_PASSWORD is required there and is
# also the server's S3 secret; use a long random string. S3_BUCKET above names the bucket (default syllabi).
MINIO_ROOT_USER=syllabi
MINIO_ROOT_PASSWORD=
# docker-compose.code-exec.yml only: group id of /var/run/docker.sock (stat -c %g /var/run/docker.sock).
# DOCKER_GID=

# ─── Database / cache ────────────────────────────────────────────────────────────────────
# MongoDB. Library import and index maintenance use transactions, which need a replica set
# (a single-node replica set is enough: mongod --replSet rs0, then rs.initiate()).
MONGODB_URI=mongodb://127.0.0.1:27017/syllabi
# Redis: rate limits and inbox live updates. Both fail open (keep working) without it.
# REDIS_URL wins; otherwise REDIS_HOST/REDIS_PORT (default 127.0.0.1:6379).
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=
# REDIS_PORT=

# ─── Auth ────────────────────────────────────────────────────────────────────────────────
# REQUIRED. Signs session tokens, upload/download url signatures, and derives the at-rest key for
# stored Canvas tokens (rotating it makes stored Canvas tokens unreadable). Use a long random
# string, e.g. `openssl rand -hex 32`. SECRET_KEY is read as a fallback name.
JWT_SECRET=
# SECRET_KEY=
# Session token lifetime (jsonwebtoken format), default 30d.
# JWT_EXPIRES_IN=
# Owner account (the one that runs the server). It is created ONCE, the first way that happens:
#   1. at boot from ADMIN_EMAIL + ADMIN_PASSWORD (never re-applied later); the email is the login;
#   2. POST /admin/setup from the app's first-run screen;
#   3. the CLI: `pnpm owner create ...` (dev) or `node dist/auth/cli.js create ...` (built).
# ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# First-run setup from another machine (or from inside a container, where requests are never
# loopback) requires this token in the x-setup-token header. Unset = only loopback may set up.
# SETUP_TOKEN=
# CLI only: password for `owner create` / `owner reset-password` instead of a prompt.
# OWNER_PASSWORD=

# ─── Accounts ────────────────────────────────────────────────────────────────────────────
# "closed" (default): single-owner server, nobody can sign up; the owner is made as above.
# "open": anyone can create an account (email + password, magic link, Google) at /auth. Each
# account has its own data; AI features need a verified email.
# REGISTRATION=closed
# The web app's public URL, e.g. https://app.syllabi.studio. Email links point at
# <APP_URL>/auth/verify/, /auth/magic/, /auth/reset/, and Google sign-in may only return to this
# origin or to the Android app (studio.syllabi.app://). Required for Google sign-in.
# APP_URL=
# Outgoing mail for verify / sign-in / reset links. Resend (HTTP API key) wins over SMTP.
# With neither set, the links are printed to the server log (development only).
# RESEND_API_KEY=
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender, e.g. "Syllabi <no-reply@example.com>" (must be a verified sender with Resend).
# MAIL_FROM=
# "Continue with Google": an OAuth client (type Web application) from Google Cloud Console.
# Its authorized redirect URI must be <PUBLIC_BASE_URL>/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Object storage ──────────────────────────────────────────────────────────────────────
# "local": files under LOCAL_STORAGE_DIR, served by this server at /files (no expiry on reads).
# "s3":    any S3-compatible store (MinIO, AWS S3, Cloudflare R2, Garage, ...).
# Default: local, unless NODE_ENV=production (then s3).
STORAGE_DRIVER=local
# Local driver root (default ./public/files, relative to where the server starts).
# LOCAL_STORAGE_DIR=
# S3 API endpoint the SERVER uses. Omit for AWS S3. Example for docker compose: http://minio:9000
S3_ENDPOINT=
# Region (default us-east-1; MinIO ignores it).
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style urls (bucket in the path). Default true, which MinIO needs. Set false for AWS
# virtual-hosted style.
S3_FORCE_PATH_STYLE=true
# How the app reaches stored files:
#   STORAGE_PROXY=true    every read and upload goes through this server (signed /objects/<key>
#                         urls and PUT /study/dev-upload). The bucket can stay private and
#                         unreachable from the tablet. This is what docker-compose.yml uses.
#   STORAGE_PROXY=false   the app talks to the bucket directly with presigned urls. The bucket
#                         must then be reachable from the device and allow CORS GET/PUT.
# Default: true when S3_ENDPOINT is set and S3_PRESIGN_ENDPOINT is not, else false.
# STORAGE_PROXY=
# Direct mode only: the bucket endpoint as the DEVICE sees it, used to sign urls (SigV4 signs the
# host, so a url signed for http://minio:9000 cannot be rewritten later). Default S3_ENDPOINT.
# S3_PRESIGN_ENDPOINT=
# Public origin for non-expiring question-image urls, e.g. a public-read bucket or CDN
# (https://cdn.example.com). Unset: local/proxy modes serve them from this server; direct mode
# falls back to <endpoint>/<bucket>/<key>, which only works on a public-read bucket.
# S3_PUBLIC_BASE_URL is accepted as an older alias.
# S3_PUBLIC_URL=
# S3_PUBLIC_BASE_URL=

# ─── AI ──────────────────────────────────────────────────────────────────────────────────
# Text AI (tutor, question extraction, summaries, concept maps): any OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Model for the heavier jobs (default: DEEPSEEK_MODEL).
# DEEPSEEK_MODEL_PRO=
# Only reported in status output; the study module always uses the client above. "deepseek" | "gemini".
# AI_PROVIDER=
# Peak-hour avoidance for non-urgent batch work (default on; "off" disables).
# Windows are UTC hour ranges, half-open (default "1-4,6-10"); days are 0=Sun..6=Sat, inclusive (default "1-5").
# DEEPSEEK_PEAK_AVOIDANCE=
# DEEPSEEK_PEAK_WINDOWS_UTC=
# DEEPSEEK_PEAK_DAYS_UTC=
# OpenRouter: vision (page reading, figure crops), speech-to-text (lectures, dictation), ink
# classification. Those features are unavailable without it.
OPENROUTER_API_KEY=
# Claude for everyone else: with a key set, every verified account that is not premium gets the
# text and picture-reading AI on Claude through this key (voice and image generation stay premium).
# Unset: AI stays premium only.
# ANTHROPIC_API_KEY=
# Last day Claude AI is open to non-premium accounts (ISO date = through the end of that day UTC,
# or a full ISO time). Unset: no end date.
# CLAUDE_AI_UNTIL=
# Monthly cap (USD) on Claude spend for non-premium accounts (default 195). Past it, text AI falls
# back to DeepSeek and picture reading pauses until next month.
# CLAUDE_MONTHLY_BUDGET_USD=
# AI requests per non-premium account per day (default 150; 0 = no limit).
# CLAUDE_DAILY_REQUESTS=

# ─── Background work ─────────────────────────────────────────────────────────────────────
# Default true: the API process also runs Canvas sync, lecture/video jobs and summaries.
# Set false and run `node dist/worker.js` (one instance) to move that work out of the API.
# RUN_WORKER_IN_PROCESS=
# Canvas sync schedule (node-cron syntax), default every 30 min: */30 * * * *
# STUDY_CANVAS_SYNC_CRON=
# Job table poll interval in ms (default 120000 in-process, 15000 in the worker).
# STUDY_JOBS_POLL_MS=
# Leave unset on a single process. With several replicas, only the one with "0" (or unset) schedules.
# NODE_APP_INSTANCE=

# ─── Code runner (DANGEROUS, off by default) ─────────────────────────────────────────────
# true enables POST /study/code/run: user-supplied C++ is compiled and run in a throwaway
# `gcc:14` docker container (no network, read-only fs, memory/pid limits). The server then needs
# the docker CLI and a docker daemon. Inside docker compose that means mounting the host's
# /var/run/docker.sock, which gives the server container root-equivalent control of the host.
# Anyone who can sign in can run code. Leave unset unless you accept that.
# CODE_EXEC_ENABLED=

# ─── Rendering ───────────────────────────────────────────────────────────────────────────
# Chromium for page renders and lecture PDFs (puppeteer reads this itself). The Docker image
# sets /usr/bin/chromium. Outside Docker, point it at an installed Chrome/Chromium.
# PUPPETEER_EXECUTABLE_PATH=
# Max notebook pages rasterised per ink render request (default 200).
# WHITEBOARD_INK_MAX_PAGES=

# ─── Logging ─────────────────────────────────────────────────────────────────────────────
# Optional BetterStack (Logtail) shipping. Unset = console only.
# BETTERSTACK_SOURCE_TOKEN=
# BETTERSTACK_ENDPOINT=
